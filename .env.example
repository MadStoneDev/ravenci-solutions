# RAVENCI Solutions — environment variables
# Copy to .env.local and fill in. Every var below is read somewhere in the code.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.

# --- App -------------------------------------------------------------------
# Base URL, used for Stripe success/cancel redirects and email links.
NEXT_PUBLIC_BASE_URL=http://localhost:3377

# --- Stripe (payments) -----------------------------------------------------
# Keep BOTH keys set. The app uses the TEST key outside production (local dev /
# Vercel preview) and the LIVE key in production, and derives test vs live Price
# IDs from whichever key is active. No env swapping needed.
STRIPE_SECRET_KEY=sk_live_xxx          # live secret key (used in production)
STRIPE_TEST_SECRET_KEY=sk_test_xxx     # test secret key (used in dev/preview)
STRIPE_WEBHOOK_SECRET=whsec_xxx        # only needed if the Stripe webhook is used
# No publishable key is required: checkout is Stripe-hosted (server creates the
# session, the browser redirects to it). There is no client-side Stripe.js.

# --- Rate limiting (Upstash Redis) ----------------------------------------
UPSTASH_URL=
UPSTASH_API_TOKEN=

# --- reCAPTCHA v3 (forms) --------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Transactional email (MailerSend) -------------------------------------
MAILERSEND_API_KEY=
MAILERSEND_RAVENCI_EMAIL=
MAILERSEND_RAVENCI_NAME=

# --- Email marketing / lists (MailerLite) ---------------------------------
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_AUDIT_REPORT=
MAILERLITE_GROUP_AUDIT_SENT=
MAILERLITE_GROUP_LAUNCH_YOUR_VISION=
MAILERLITE_GROUP_VISIBILITY_CHECK=

# --- Analytics (all optional; omit to disable that tracker) ----------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_URL=
NEXT_PUBLIC_OPENPANEL_API_URL=
OPENPANEL_CLIENT_SECRET=

# --- Integrations / misc ---------------------------------------------------
PAGESPEED_API_KEY=                 # Google PageSpeed (home page scores)
NEXT_PUBLIC_CALENDLY_URL=          # Calendly booking link
DESIGN_ACCESS_TOKEN=               # gate for the /design preview route
ADMIN_API_TOKEN=                   # admin API (send audit report)

# --- Set automatically; do NOT define these yourself -----------------------
# NODE_ENV   — "development" under `npm run dev`, "production" under build/start
# VERCEL_ENV — "production" | "preview" | "development" on Vercel
# Together they drive Stripe mode: non-production => TEST, production => LIVE.
